# Ohm standard library — the component-type taxonomy (std.kinds, ADR-008)
#
# A `kind` is a checkable CONTRACT for a category of part: the pins (by role) and
# params EVERY in-production member genuinely has. A component declares the kinds
# it IS (`component TLV9061(OpAmp):`) and binds each required member to a pin
# (`pin OUT: role=output, pad=1, is=out`); the compiler verifies conformance.
#
# HONESTY / OPEN-WORLD (N3):
#   * `requires` is adversarially MINIMAL — only what NO real member lacks. Things
#     that vary (op-amp V-, LDO EN, shunt-ref supply, 4-terminal MOSFET body) are
#     `optional`, never required, so a legitimate part never false-fails.
#   * A component with NO declared kind is the base `Component` — unchecked. The
#     taxonomy never claims to enumerate every device; unknown = unasserted.
#   * IS-A refinement (Schottky(Diode)) is a shallow single spine; capabilities
#     (ThermalPad, ExposedPad) are orthogonal kinds that compose freely.

# ---------- passives ----------
kind TwoTerminal:
    requires a: passive
    requires b: passive

# defining param names match the library's attr convention (`value`, `freq`), so
# a retrofit `component Resistor(Resistor)` with `value=10kohm` conforms directly.
kind Resistor(TwoTerminal):
    param value: resistance

kind Capacitor(TwoTerminal):
    param value: capacitance

kind Inductor(TwoTerminal):
    param value: inductance

kind Crystal(TwoTerminal):
    # a/b redeclared (same role as TwoTerminal — good diamond): `expects` may only
    # name a kind's OWN members, and load caps hang off exactly these two nets.
    requires a: passive
    requires b: passive
    param freq: frequency
    # bring-up (ADR-009): gated on a declared `cl` attr, so parts/MCUs with
    # integrated load caps stay quiet by default. Declare cl= to opt in.
    expects loadcaps(1pF, 100pF) on a, b when cl

# ---------- diodes (polar two-terminal spine) ----------
# Vf/Vz/Vbr vary in how they're specified and are often left to the datasheet, so
# they are NOT required params — the subtypes just refine the pin contract.
kind Diode:
    requires anode: passive
    requires cathode: passive

kind Zener(Diode)

kind Schottky(Diode)

kind LED(Diode)

kind TVS(Diode)

# ---------- transistors ----------
kind BJT:
    requires base: input
    requires collector: passive
    requires emitter: passive

kind MOSFET:
    requires gate: input
    requires drain: passive
    requires source: passive
    optional body: passive        # brought out only on 4-terminal parts
    # bring-up (ADR-009): a floating gate is a respin; any driver, rail, or
    # gate resistor satisfies it (push-pull GPIO topologies pass as-is)
    expects tie on gate

kind JFET:
    requires gate: input
    requires drain: passive
    requires source: passive

# ---------- analog ICs ----------
kind OpAmp:
    requires inp: input
    requires inn: input
    requires out: output
    requires vpos: power_in
    optional vneg: power_in       # single-supply parts omit — NOT required
    # bring-up (ADR-009): supply decoupling is the universal rule — no gate
    expects decoupling(10nF, 10uF) on vpos

kind Comparator:
    requires inp: input
    requires inn: input
    requires out: output          # push-pull; open-collector parts override role=open_collector
    requires vpos: power_in
    optional vneg: power_in
    expects decoupling(10nF, 10uF) on vpos

kind VoltageReference:
    requires out: output          # shunt refs are 2-terminal + ref; supply is optional
    optional vpos: power_in

# ---------- power ICs ----------
kind LDO:
    requires vin: power_in
    requires vout: power_out
    optional gnd: ground          # floating adjustable regs (LM317, LT3080) have no GND
    optional en: input            # fixed 3-pin LDOs have none
    # bring-up (ADR-009): gated — only checked when the author declares the part
    # needs input/output caps (cin_min= / cout_min= attrs on their component)
    expects cap(1uF) on vout when cout_min
    expects cap(100nF) on vin when cin_min

kind SwitchingConverter:
    requires vin: power_in
    requires gnd: ground
    optional sw: output           # integrated-inductor modules (Recom R-78) expose no SW node
    # bring-up (ADR-009): gated as on LDO. No vout member on this kind (integrated
    # modules vary), so only the input-cap expectation is expressible here.
    expects cap(100nF) on vin when cin_min

# ---------- logic / interface ----------
kind LogicGate:
    requires out: output
    requires vcc: power_in
    requires gnd: ground
    expects decoupling(10nF, 10uF) on vcc

kind Buffer(LogicGate):
    requires inp: input

kind Transceiver:
    requires vcc: power_in
    requires gnd: ground
    expects decoupling(10nF, 10uF) on vcc

# ---------- misc ----------
kind Oscillator:
    requires out: output
    requires vcc: power_in
    requires gnd: ground
    expects decoupling(10nF, 10uF) on vcc

kind Optocoupler:
    requires led_anode: input      # the isolated LED (input) side
    requires led_cathode: input

kind Relay:
    requires coil_a: passive       # coil is a passive inductive load
    requires coil_b: passive
    requires com: passive

kind Fuse(TwoTerminal)

# A connector is a mechanical mating interface; electrically its pins are
# role-agnostic. The only universal is "has at least one contact" — so no
# required members here (extends the open base).
kind Connector:
    optional shield: ground

# A sensor is a nominal category — even "produces a signal" is not universal:
# I2C/SPI digital sensors carry data on a bidirectional bus, not an `output` pin
# (BME280, SHT31, MPU6050). So `signal` is optional; declaring (Sensor) is intent.
kind Sensor:
    optional signal: output

# ---------- more two-terminal passives (refine TwoTerminal, no new members) ----------
kind FerriteBead(TwoTerminal)
kind Thermistor(TwoTerminal)
kind Varistor(TwoTerminal)
kind Buzzer(TwoTerminal)         # a driven 2-terminal sounder

kind Potentiometer:              # 3-terminal: two element ends + a wiper
    requires t1: passive
    requires wiper: passive
    requires t2: passive

kind Switch:                     # minimal SPST: two contacts (poles/throws vary)
    requires a: passive
    requires b: passive

# ---------- magnetics ----------
kind Transformer:                # 2-winding minimum; multi-winding parts add pins
    requires p1: passive
    requires p2: passive
    requires s1: passive
    requires s2: passive

kind CommonModeChoke:            # two coupled windings
    requires in1: passive
    requires out1: passive
    requires in2: passive
    requires out2: passive

# ---------- discretes / power ----------
kind BridgeRectifier:            # 2 AC in, 2 DC out
    requires ac1: passive
    requires ac2: passive
    requires dcp: passive
    requires dcn: passive

kind Battery:                    # a source: + rail out, - return
    requires pos: power_out
    requires neg: ground

# ---------- rf / clock ----------
kind Antenna:
    requires feed: passive
    optional gnd: ground

kind Resonator:                  # ceramic resonator: 2 terminals + optional gnd
    requires a: passive
    requires b: passive
    optional gnd: ground

# A display's pinouts are entirely part-specific (segment/common count varies);
# this is a nominal marker (declares intent, no structural contract to enforce).
kind Display

# ---------- orthogonal capabilities (compose with any kind) ----------
# Polarized: member `a` is the POSITIVE terminal, `b` the negative. Shares
# member names with TwoTerminal (good diamond) so e.g.
# `component CapacitorPolarized(Capacitor, Polarized)` binds one pin per member.
# Enables B009: reverse-bias detection against declared operating voltages.
kind Polarized:
    requires a: passive
    requires b: passive

kind ThermalPad:
    requires ep: passive

kind ExposedPad:
    requires ep: passive

kind Shielded:
    requires shield: ground
