# Ohm standard library — connectivity blocks (std.connectivity)
#
# Bus transceivers and USB connectors. Designed to pair with the typed
# bundles in std.interfaces (CAN, RS485, UART, USB2, Power):
#     use std.interfaces
#     use std.connectivity
#     bus = io(RS485)
#     u = RS485Transceiver_SOIC8()
#     bus.a ~ u.A
#     bus.b ~ u.B
#
# Honesty (N3):
# - Concrete pads are declared ONLY where the pinout is a genuine de-facto
#   or de-jure standard; vendor-variable pins are flagged in comments.
# - NO invented ratings — declare vmax/imax per instance from your
#   datasheet.
# - String footprints are "Lib:Name" KiCad ids verified on disk; every pad
#   id was read from the actual .kicad_mod file.

# CAN transceiver in the industry-standard SOIC-8 pinout (TJA1050 lineage:
# TJA1042/1051, MCP2551/2561, SN65HVD23x, SIT1042...):
#   1 = TXD, 2 = GND, 3 = VCC, 4 = RXD, 6 = CANL, 7 = CANH.
# Positions 1,2,3,4,6,7 are the de-facto standard across vendors.
# VENDOR-VARIABLE: pin 5 (VREF on TJA1050, VIO on TJA1042/3, SPLIT or NC
# elsewhere) and pin 8 (RS slope control on TJA1050/MCP2551, STB standby on
# TJA1042/51, S on others) differ by part — verify both on your datasheet.
component CANTransceiver_SOIC8:
    package = generate(SOIC, pins=8)
    designator_prefix = "U"
    pin TXD:  role=input, pad=1
    pin GND:  role=ground, pad=2
    pin VCC:  role=power_in, pad=3
    pin RXD:  role=output, pad=4
    pin VREF: role=passive, pad=5
    pin CANL: role=bidirectional, pad=6
    pin CANH: role=bidirectional, pad=7
    pin RS:   role=input, pad=8

# RS-485 transceiver in the MAX485/SN75176 standard SOIC-8 pinout — the
# de-facto standard second-sourced by essentially every vendor (MAX485,
# SN75176, SP485, THVD1450, ADM485...):
#   1 = RO (receiver out), 2 = /RE (receiver enable, active low),
#   3 = DE (driver enable), 4 = DI (driver in), 5 = GND,
#   6 = A (non-inverting), 7 = B (inverting), 8 = VCC.
component RS485Transceiver_SOIC8:
    package = generate(SOIC, pins=8)
    designator_prefix = "U"
    pin RO:  role=output, pad=1
    pin RE:  role=input, pad=2
    pin DE:  role=input, pad=3
    pin DI:  role=input, pad=4
    pin GND: role=ground, pad=5
    pin A:   role=bidirectional, pad=6
    pin B:   role=bidirectional, pad=7
    pin VCC: role=power_in, pad=8

# USB Micro-B receptacle. Footprint: Amphenol 10118193-0001LF (the
# ubiquitous cheap SMD micro-B). Pads read from the .kicad_mod: signal pads
# 1..5 plus shell/shield pads all numbered "6". Pin functions 1..5 are
# fixed by the USB Micro-B spec: 1 = VBUS, 2 = D-, 3 = D+, 4 = ID,
# 5 = GND. VBUS is power_out here: device-side receptacle sourcing the
# board from the host.
component USBConnector_MicroB:
    package = "Connector_USB:USB_Micro-B_Amphenol_10118193-0001LF_Horizontal"
    designator_prefix = "J"
    pin VBUS:   role=power_out, pad=1
    pin DM:     role=bidirectional, pad=2
    pin DP:     role=bidirectional, pad=3
    pin ID:     role=passive, pad=4
    pin GND:    role=ground, pad=5
    pin SHIELD: role=passive, pad=6

# USB-C receptacle, 16-pin USB 2.0 variant. Footprint: GCT USB4105 (the
# common 16-pin top-mount part; HRO TYPE-C-31-M-12 shares the same pad
# set). Pad ids read from the .kicad_mod: A1 A4-A9 A12, B1 B4-B9 B12, plus
# shield pads "S1". The pad->function map below is fixed by the USB Type-C
# spec (16-pin USB 2.0 subset): GND = A1/B1/A12/B12, VBUS = A4/B4/A9/B9,
# CC1 = A5, CC2 = B5, D+ = A6/B6, D- = A7/B7, SBU1 = A8, SBU2 = B8.
# The two D+/D- pads are separate receptacle contacts (plug-flip mirror) —
# tie DP_A6~DP_B6 and DM_A7~DM_B7 together on the board.
# Roles: only VBUS_A4 is power_out; the other three VBUS pads are passive
# so tying all four to one VBUS net (as you must) does not trip the
# single-driver-per-net check (I003) — electrically they are one rail.
component USBConnector_C16:
    package = "Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal"
    designator_prefix = "J"
    pin GND_A1:  role=ground, pad=A1
    pin VBUS_A4: role=power_out, pad=A4
    pin CC1:     role=bidirectional, pad=A5
    pin DP_A6:   role=bidirectional, pad=A6
    pin DM_A7:   role=bidirectional, pad=A7
    pin SBU1:    role=passive, pad=A8
    pin VBUS_A9: role=passive, pad=A9
    pin GND_A12: role=ground, pad=A12
    pin GND_B1:  role=ground, pad=B1
    pin VBUS_B4: role=passive, pad=B4
    pin CC2:     role=bidirectional, pad=B5
    pin DP_B6:   role=bidirectional, pad=B6
    pin DM_B7:   role=bidirectional, pad=B7
    pin SBU2:    role=passive, pad=B8
    pin VBUS_B9: role=passive, pad=B9
    pin GND_B12: role=ground, pad=B12
    pin SHIELD:  role=passive, pad=S1
