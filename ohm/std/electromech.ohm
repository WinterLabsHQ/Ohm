# Ohm standard library — electromechanical blocks (std.electromech)
#
# Headers, switches, a relay, and a solder jumper. These are CATEGORIES with
# real, verified KiCad footprints; swap `package=` per instance for your
# actual part's footprint.
#
# Honesty (N3):
# - NO invented ratings: no vmax/imax/pmax defaults. A relay coil voltage or
#   a switch contact rating is YOUR datasheet's fact — declare it per
#   instance (e.g. k1 = Relay_SPDT(mpn="SRD-05VDC-SL-C")).
# - Every string footprint is a "Lib:Name" KiCad id verified to exist on
#   disk; every pad id below was read from the actual .kicad_mod file.
# - Where a pad->function mapping is vendor-variable it is flagged in a
#   comment — verify against your datasheet before fabbing.

# ---------- pin headers (2.54 mm, vertical THT) ----------
# Pads 1..N read from the .kicad_mod files; pin 1 is the marked end.
# Headers carry whatever you wire through them: role=passive throughout.

component Header_1x02:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2

component Header_1x03:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3

component Header_1x04:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3
    pin P4: role=passive, pad=4

component Header_1x05:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x05_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3
    pin P4: role=passive, pad=4
    pin P5: role=passive, pad=5

component Header_1x06:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x06_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3
    pin P4: role=passive, pad=4
    pin P5: role=passive, pad=5
    pin P6: role=passive, pad=6

component Header_1x08:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x08_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3
    pin P4: role=passive, pad=4
    pin P5: role=passive, pad=5
    pin P6: role=passive, pad=6
    pin P7: role=passive, pad=7
    pin P8: role=passive, pad=8

component Header_1x10:
    package = "Connector_PinHeader_2.54mm:PinHeader_1x10_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1:  role=passive, pad=1
    pin P2:  role=passive, pad=2
    pin P3:  role=passive, pad=3
    pin P4:  role=passive, pad=4
    pin P5:  role=passive, pad=5
    pin P6:  role=passive, pad=6
    pin P7:  role=passive, pad=7
    pin P8:  role=passive, pad=8
    pin P9:  role=passive, pad=9
    pin P10: role=passive, pad=10

# 2-row headers: KiCad numbers pads 1..2N (odd row / even row zig-zag,
# matching ribbon-cable IDC numbering). Pads 1..6 / 1..10 read from disk.
component Header_2x03:
    package = "Connector_PinHeader_2.54mm:PinHeader_2x03_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3
    pin P4: role=passive, pad=4
    pin P5: role=passive, pad=5
    pin P6: role=passive, pad=6

component Header_2x05:
    package = "Connector_PinHeader_2.54mm:PinHeader_2x05_P2.54mm_Vertical"
    designator_prefix = "J"
    pin P1:  role=passive, pad=1
    pin P2:  role=passive, pad=2
    pin P3:  role=passive, pad=3
    pin P4:  role=passive, pad=4
    pin P5:  role=passive, pad=5
    pin P6:  role=passive, pad=6
    pin P7:  role=passive, pad=7
    pin P8:  role=passive, pad=8
    pin P9:  role=passive, pad=9
    pin P10: role=passive, pad=10

# ---------- switches ----------

# 4-pin SMD tactile switch. Footprint: MEC Multimec 5G series (5GSH9),
# pads 1..4 read from the .kicad_mod (two per side: 1,2 left / 3,4 right).
# 4-pin tact switches have TWO internally-connected pairs — per KiCad's
# paired SW_MEC_5G symbol (and the common 6 mm B3F-class convention) pads
# 1-2 are one pole and 3-4 the other; the switch closes 1/2 <-> 3/4.
# VENDOR-VARIABLE: some tact families pair across the diagonal — verify the
# internal pairing against your datasheet before relying on it.
component TactSwitch4:
    package = "Button_Switch_SMD:SW_MEC_5GSH9"
    designator_prefix = "SW"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2
    pin P3: role=passive, pad=3
    pin P4: role=passive, pad=4

# SPDT slide switch. Footprint: C&K JS102011SAQN (JS series, SMD), pads
# 1..3 read from the .kicad_mod. Per the C&K JS-series datasheet the CENTER
# terminal (pad 2) is the common; position 1 closes 1-2, position 2 closes
# 2-3. Center-common is near-universal for 3-pin slide switches, but verify
# against your datasheet.
component SlideSwitch:
    package = "Button_Switch_SMD:SW_SPDT_CK_JS102011SAQN"
    designator_prefix = "SW"
    pin A:   role=passive, pad=1
    pin COM: role=passive, pad=2
    pin B:   role=passive, pad=3

# ---------- relay ----------

# SPDT power relay. Footprint: Sanyou SRD series, Form C (the ubiquitous
# Songle/Sanyou SRD "relay module" relay). Pads 1..5 read from the
# .kicad_mod; the function map below is taken from KiCad's officially
# paired Relay:SANYOU_SRD_Form_C symbol (coil = pads 2/5, COM = 1, NO = 3,
# NC = 4) and matches the footprint geometry (COM sits at the coil end,
# NO/NC 12 mm apart at the contact end). SRD coils are non-polarized.
# N3: coil voltage/contact ratings are per-part — declare them at
# instantiation from your datasheet (e.g. SRD-05VDC-SL-C = 5 V coil).
component Relay_SPDT:
    package = "Relay_THT:Relay_SPDT_SANYOU_SRD_Series_Form_C"
    designator_prefix = "K"
    pin COIL_A: role=passive, pad=2
    pin COIL_B: role=passive, pad=5
    pin COM:    role=passive, pad=1
    pin NO:     role=passive, pad=3
    pin NC:     role=passive, pad=4

# ---------- jumper ----------

# 2-pad solder jumper, open by default (bridge with solder to close).
# Pads 1..2 read from the .kicad_mod.
component Jumper:
    package = "Jumper:SolderJumper-2_P1.3mm_Open_Pad1.0x1.5mm"
    designator_prefix = "JP"
    pin P1: role=passive, pad=1
    pin P2: role=passive, pad=2

# ---------- appended: DIP switch, rotary encoder, buzzer, SSR/DPDT relays ----------

# 4-position DIP switch = 4 independent SPST poles = 8 pads. Footprint: KiCad
# SW_DIP_SPSTx04 (SMD, W8.61mm), pads 1..8 read from the .kicad_mod. Like a DIP
# IC the pads wrap around: pole i closes pad i <-> pad (9-i). Verified against
# the footprint geometry (pad i and pad 9-i share the same Y, opposite X):
#   pole 1 = pad 1 <-> pad 8,  pole 2 = pad 2 <-> pad 7,
#   pole 3 = pad 3 <-> pad 6,  pole 4 = pad 4 <-> pad 5.
# A<n>/B<n> are the two ends of pole n (a switch has no polarity).
component DIPSwitch_4:
    package = "Button_Switch_SMD:SW_DIP_SPSTx04_Slide_9.78x12.34mm_W8.61mm_P2.54mm"
    designator_prefix = "SW"
    pin A1: role=passive, pad=1
    pin B1: role=passive, pad=8
    pin A2: role=passive, pad=2
    pin B2: role=passive, pad=7
    pin A3: role=passive, pad=3
    pin B3: role=passive, pad=6
    pin A4: role=passive, pad=4
    pin B4: role=passive, pad=5

# Incremental rotary encoder with integrated push switch (Alps EC11 standard —
# the ubiquitous "EC11" panel encoder). Footprint:
# RotaryEncoder_Alps_EC11E-Switch_Vertical_H20mm; pad ids A/B/C/S1/S2/MP read
# from the .kicad_mod (non-numeric string pads). Quadrature: A and B are the two
# phase outputs, C is their common; SW1/SW2 are the push-switch terminals; MNT is
# the metal shell / mounting posts (the .kicad_mod has two pads both id "MP" —
# usually tied to GND for shielding). Tie C to GND for the common EC11 wiring.
component RotaryEncoder_EC11:
    package = "Rotary_Encoder:RotaryEncoder_Alps_EC11E-Switch_Vertical_H20mm"
    designator_prefix = "EC"
    pin A:   role=output,  pad=A     # quadrature phase A
    pin B:   role=output,  pad=B     # quadrature phase B
    pin C:   role=passive, pad=C     # quadrature common (usually GND)
    pin SW1: role=passive, pad=S1    # push switch
    pin SW2: role=passive, pad=S2    # push switch
    pin MNT: role=passive, pad=MP    # shell / mounting (shield, often GND)

# 2-pin buzzer (magnetic or piezo). Footprint: CUI magnetic transducer, pads
# 1..2 read from the .kicad_mod. N3 / VENDOR-VARIABLE polarity: DC magnetic /
# electromagnetic buzzers ARE polarized — the marked terminal (commonly pad 1)
# is "+"; piezo transducers are NON-polarized. Pins named P1/P2 (neutral);
# confirm the +/- assignment against your buzzer's datasheet.
component Buzzer:
    package = "Buzzer_Beeper:MagneticBuzzer_CUI_CST-931RP-A"
    designator_prefix = "BZ"
    pin P1: role=passive, pad=1      # marked "+" on polarized DC types
    pin P2: role=passive, pad=2

# ---------------------------------------------------------------------------
# TEMPLATE (adapt to your datasheet): DPDT relay
#
# Unlike Relay_SPDT (KiCad ships a documented, geometry-paired SANYOU_SRD
# symbol), the DPDT footprints in Relay_THT.pretty (Omron G6S-2, Schrack RT2,
# Fujitsu FTR-F1C, ...) do NOT carry a per-pad function map on disk — KiCad's
# DPDT symbols name every pin "~", so coil-vs-COM/NO/NC per pad is NOT
# confidently decodable without the specific datasheet. So this is a TEMPLATE:
# copy it, set package= to your DPDT footprint id, and map the 8 pads using the
# canonical IEC roster below (A1/A2 = coil; pole 1 = 11/12/14, pole 2 = 21/22/24,
# where x1 = COM, x2 = NC, x4 = NO). The compiler then checks your pin<->pad map.
#
#   component Relay_DPDT:
#       package = <Relay_THT:YourDPDTFootprint>
#       designator_prefix = "K"
#       pin COIL_A: role=passive, pad=<A1 pad>
#       pin COIL_B: role=passive, pad=<A2 pad>
#       pin COM1:   role=passive, pad=<pole-1 common pad>
#       pin NC1:    role=passive, pad=<pole-1 NC pad>
#       pin NO1:    role=passive, pad=<pole-1 NO pad>
#       pin COM2:   role=passive, pad=<pole-2 common pad>
#       pin NC2:    role=passive, pad=<pole-2 NC pad>
#       pin NO2:    role=passive, pad=<pole-2 NO pad>
#
# ---------------------------------------------------------------------------
# TEMPLATE (adapt to your datasheet): solid-state relay (SSR)
#
# SSR pinouts are family-specific: DC-input opto side + output side, in DIP-4/6,
# SIP or discrete packages, with different pad orders (Panasonic AQH, IXYS
# CPC1xxx, Omron G3VM, ...). No de-facto standard pad map -> TEMPLATE. Copy,
# set package= to your SSR footprint, and map the input (LED) and output pads
# from the datasheet. N3: input trigger current and output voltage/current
# ratings are per-part datasheet facts — declare them per instance.
#
#   component RelaySSR:
#       package = <Relay_SMD:YourSSRFootprint>   # or generate(SOIC, pins=8)
#       designator_prefix = "K"
#       pin IN_P:  role=input,   pad=<anode pad>     # opto-input LED "+"
#       pin IN_N:  role=input,   pad=<cathode pad>   # opto-input LED "-"
#       pin OUT1:  role=passive, pad=<load pad 1>    # output switch terminal
#       pin OUT2:  role=passive, pad=<load pad 2>    # output switch terminal
