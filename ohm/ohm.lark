// ohm.lark — THE grammar (build manual Part 3, v1 syntax)
// Indentation-based (Python-shaped), newline-significant, `#` comments.

start: (_NL | top_decl)*

top_decl: interface_decl
        | component_decl
        | module_decl
        | kind_decl
        | fn_decl
        | use_stmt

// ---------- pure compile-time functions (ADR-012 E0) ----------
fn_decl: "fn" NAME "(" [fn_params] ")" "=" expr _NL
fn_params: NAME ("," NAME)*

// ---------- imports (ADR-007) ----------
use_stmt: "use" (ref | STRING) _NL

// ---------- kind (component-type taxonomy, ADR-008) ----------
// body optional: `kind Zener(Diode)` refines with no new members
kind_decl: "kind" NAME conforms? ((":" _NL _INDENT kind_item+ _DEDENT) | _NL)
kind_item: "requires" NAME ":" NAME _NL   -> req_pin
         | "optional" NAME ":" NAME _NL   -> opt_pin
         | "param" NAME ":" NAME _NL      -> kind_param
         | expects_item

// ---------- expects (bring-up requirement predicates, ADR-009) ----------
expects_item: "expects" NAME expects_args? expects_on? expects_when? _NL
expects_args: "(" arguments ")"
expects_on: "on" NAME ("," NAME)*
expects_when: "when" NAME

conforms: "(" ref ("," ref)* ")"          // declared kinds / parent kinds

// ---------- interface (R5) ----------
interface_decl: "interface" NAME ":" _NL _INDENT interface_item+ _DEDENT

interface_item: NAME ":" NAME ("," attr)* _NL     -> member_decl
              | "require" call _NL                -> require_decl
              | expects_item

// ---------- component (R1) ----------
component_decl: "component" NAME conforms? ":" _NL _INDENT component_item+ _DEDENT

component_item: "pin" NAME ":" attr ("," attr)* _NL   -> pin_decl
              | NAME "=" sum _NL                      -> attr_decl

// ---------- module (R6) ----------
module_decl: "module" NAME ":" _NL _INDENT module_item+ _DEDENT

module_item: NAME "=" call _NL                    -> binding
           | NAME "=" cnt "*" call _NL            -> array_binding
           | ref "~" ref _NL                      -> connect
           | "assert" expr _NL                    -> assert_stmt
           | "obligation" call cmp_op expr _NL    -> obligation_stmt
           | "constraint" call _NL                -> constraint_stmt
           | for_stmt
           | if_stmt

// ---------- bounded repetition (ADR-010): unrolled at elaborate ----------
// counts/bounds: literal, or a config name (+/- literal offset) with a literal
// default (ADR-012 E0) — folded at elaborate, override-guarded like values
!cnt: NUMBER | NAME
!bnd: NUMBER | NAME (("+" | "-") NUMBER)?
for_stmt: "for" NAME "in" bnd ".." bnd ":" _NL _INDENT loop_item+ _DEDENT
loop_item: ref "~" ref _NL                        -> connect
         | "assert" expr _NL                      -> assert_stmt
         | "constraint" call _NL                  -> constraint_stmt

// ---------- compile-time variants (ADR-012 E0): the taken branch elaborates ----------
if_stmt: "if" expr ":" _NL _INDENT module_item+ _DEDENT else_blk?
else_blk: "else" ":" _NL _INDENT module_item+ _DEDENT

// ---------- shared pieces ----------
// attr/kwarg values accept closed-form arithmetic (`sum`, ADR-010); `sum`
// subsumes every plain literal form (STRING/quantity/NUMBER/call/ref)
attr: NAME "=" sum

call: ref "(" [arguments] ")"
arguments: argument ("," argument)*
argument: NAME "=" sum     -> kwarg
        | sum              -> posarg

ref: NAME index? ("." NAME index?)*
// literal, loop variable, or loop-var +/- literal offset for chains (ADR-010 G1)
!index: "[" (NUMBER | NAME (("+" | "-") NUMBER)?) "]"

// ---------- expressions (R7 assert / obligation bounds) ----------
?expr: comparison
     | sum
comparison: sum cmp_op sum
!cmp_op: "<=" | ">=" | "<" | ">" | "==" | "!="
?sum: product
    | sum "+" product      -> add
    | sum "-" product      -> sub
?product: atom
        | product "*" atom -> mul
        | product "/" atom -> div
?atom: quantity
     | NUMBER              -> number
     | STRING              -> string
     | call
     | ref
     | "(" expr ")"

// ---------- quantities (R3) ----------
quantity: QUANTITY tolerance?
tolerance: TOLOP QUANTITY        -> tol_abs
         | TOLOP NUMBER "%"     -> tol_pct

// ---------- terminals ----------
TOLOP: "+/-"
QUANTITY: /\d+(\.\d+)?[A-Za-z]+/
NUMBER: /\d+(\.\d+)?/
NAME: /[A-Za-z_][A-Za-z0-9_]*/
STRING: /"[^"\n\r\x00-\x08\x0b-\x1f]*"/

COMMENT: /#[^\n]*/
_NL: ( /\r?\n[\t ]*/ | COMMENT )+

%declare _INDENT _DEDENT
%ignore /[\t ]+/
%ignore COMMENT
