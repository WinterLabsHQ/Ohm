(export (version "E")
  (design (source "tests/golden/divider.ohm") (tool "ohm 0.1.0"))
  (components
    (comp (ref "R1") (value "10kohm +/- 1%") (footprint "R_0402_1005Metric") (fields (field (name "ohm_ref") "r1")))
    (comp (ref "R2") (value "10kohm +/- 1%") (footprint "R_0402_1005Metric") (fields (field (name "ohm_ref") "r2")))
  )
  (nets
    (net (code "1") (name "vin.gnd") (node (ref "R2") (pin "2")))
    (net (code "2") (name "vin.v") (node (ref "R1") (pin "1")))
    (net (code "3") (name "vout") (node (ref "R1") (pin "2")) (node (ref "R2") (pin "1")))
  )
)
