(export (version "E")
  (design (source "i2c_bus.ohm") (tool "ohm 0.1.1"))
  (components
    (comp (ref "U1") (value "MCU") (footprint "QFN-16-1EP_3x3mm_P0.5mm") (fields (field (name "ohm_ref") "mcu.u")))
    (comp (ref "U2") (value "Sensor") (footprint "SOT-23-6") (fields (field (name "ohm_ref") "sens.s")))
  )
  (nets
    (net (code "1") (name "MCU_BUS_SCL") (node (ref "U1") (pin "5")) (node (ref "U2") (pin "1")))
    (net (code "2") (name "MCU_BUS_SDA") (node (ref "U1") (pin "6")) (node (ref "U2") (pin "3")))
  )
)
